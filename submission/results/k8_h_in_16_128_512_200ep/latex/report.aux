\@writefile{toc}{\contentsline {paragraph}{Test-time averaging (\textsc  {aug-K}).}{1}{section*.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{ddof.}{1}{section*.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Headline result}{1}{section.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}$k\!=\!16$ focus}{1}{section.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Mean test AP, $3$ seeds per cell. \texttt  {random\_augmented} beats both canonicalization arms (\texttt  {map}, \texttt  {oap}) at $8$ of $9$ tested $(k,h)$ cells; the exception is $k\!=\!3$/$h\!=\!512$, where \texttt  {oap} edges \texttt  {random\_augmented} by $0.0036$~AP. The right-most column is the test-time-averaged metric \textsc  {aug-$K$} (see Setup): averaging $K$ ambiguity-group draws at evaluation reliably nudges the score up by $\sim \!+0.0001$ to $+0.0005$~AP relative to a single-pass evaluation, never hurts at the configurations tested.}}{2}{table.caption.4}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:headline}{{1}{2}{Mean test AP, $3$ seeds per cell. \texttt {random\_augmented} beats both canonicalization arms (\texttt {map}, \texttt {oap}) at $8$ of $9$ tested $(k,h)$ cells; the exception is $k\!=\!3$/$h\!=\!512$, where \texttt {oap} edges \texttt {random\_augmented} by $0.0036$~AP. The right-most column is the test-time-averaged metric \textsc {aug-$K$} (see Setup): averaging $K$ ambiguity-group draws at evaluation reliably nudges the score up by $\sim \!+0.0001$ to $+0.0005$~AP relative to a single-pass evaluation, never hurts at the configurations tested}{table.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces $k\!=\!16$ headline. \texttt  {random\_augmented} wins at every $h$ by margins that exceed both seed std values. The trend is monotone in $h$: bigger model, bigger gap.}}{2}{table.caption.5}\protected@file@percent }
\newlabel{tab:k16}{{2}{2}{$k\!=\!16$ headline. \texttt {random\_augmented} wins at every $h$ by margins that exceed both seed std values. The trend is monotone in $h$: bigger model, bigger gap}{table.caption.5}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Test-time averaging (\textsc  {aug-$K$})}{2}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}Bottom line}{2}{section.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces $k\!=\!16$ test AP vs.\ hidden dim, $3$ seeds each. \texttt  {random\_augmented} (green) sits above both \texttt  {oap} (pink) and \texttt  {map} (orange) at every $h$.}}{3}{figure.caption.6}\protected@file@percent }
\newlabel{fig:headline}{{1}{3}{$k\!=\!16$ test AP vs.\ hidden dim, $3$ seeds each. \texttt {random\_augmented} (green) sits above both \texttt {oap} (pink) and \texttt {map} (orange) at every $h$}{figure.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Test-time averaging summary. At evaluation, $K$ random draws of the ambiguity group are averaged before scoring (sign flips for simple eigenvalues, Haar $O(m)$ rotations on multiplicity-$m$ blocks). $K\!=\!8$ at $k\!=\!3$ exhausts the sign group $\mathbb  {Z}_2^3$; $K\!=\!16$ at $k\!\in \!\{8,16\}$ samples the much larger group sparsely. Across all nine cells the $\Delta $ stays in the noise floor ($\le \!\pm 0.0005$~AP), with a slight positive bias on average (median $+0.0002$~AP). The \textsc  {aug-$K$} metric is consistent with single-pass; it does not flip the rankings in Table~\ref {tab:headline}.}}{3}{table.caption.7}\protected@file@percent }
\newlabel{tab:augk}{{3}{3}{Test-time averaging summary. At evaluation, $K$ random draws of the ambiguity group are averaged before scoring (sign flips for simple eigenvalues, Haar $O(m)$ rotations on multiplicity-$m$ blocks). $K\!=\!8$ at $k\!=\!3$ exhausts the sign group $\mathbb {Z}_2^3$; $K\!=\!16$ at $k\!\in \!\{8,16\}$ samples the much larger group sparsely. Across all nine cells the $\Delta $ stays in the noise floor ($\le \!\pm 0.0005$~AP), with a slight positive bias on average (median $+0.0002$~AP). The \textsc {aug-$K$} metric is consistent with single-pass; it does not flip the rankings in Table~\ref {tab:headline}}{table.caption.7}{}}
